<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      main 매니페스트는 extractNativeLibs=false(APK 용량 절약, adb_pairing 용 .so 는 실행 파일이
      아니라 dlopen 대상이라 압축 상태로도 문제없음) — 하지만 direct 플레이버는 libmttd_starter.so
      가 진짜 실행 파일(DirectDaemonStarter.kt 클래스 doc 참조)이라 `adb shell` 에서 직접 실행
      가능한 실제 파일로 디스크에 있어야 한다(APK zip 안의 압축 엔트리로는 실행 불가). 이 플레이버만
      true 로 덮어쓴다.
    -->
    <application
        android:extractNativeLibs="true"
        tools:replace="android:extractNativeLibs">
        <!--
          페어링 코드 입력 알림(RemoteInput) 전용 — 설정 앱의 "페어링 코드로 기기 페어링"
          화면을 유저가 벗어나면 그 페어링 세션 자체가 끊기므로, 화면 전환 없이 알림 서랍에서
          코드를 받아야 한다. shortService: 짧게 끝나는 작업이라 추가 FGS 권한이 필요 없다.
        -->
        <service
            android:name=".service.DirectAdbPairingService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <!--
          DirectDaemonStarter(app_process 로 shell UID 백그라운드 프로세스로 뜬 쪽)가 만든
          UserService의 Binder를 앱 프로세스로 넘겨받는 창구. exported 라야 shell UID 호출자가
          닿을 수 있다 — call() 안에서 호출자 UID를 2000(shell)으로 제한해 임의 앱의 가짜 Binder
          주입을 막는다(DirectUserServiceProvider 참조).
        -->
        <provider
            android:name=".data.adb.starter.DirectUserServiceProvider"
            android:authorities="${applicationId}.direct.userservice"
            android:exported="true" />
    </application>

</manifest>
